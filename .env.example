# Copy to .env to change the defaults. Every value is optional.

# Same seed, same data: change it to get a different shop.
SIM_SEED=42
# First day of history.
SIM_START_DATE=2025-10-01
# Average orders per day at the start date, all channels together.
SIM_ORDERS_PER_DAY=600
# Multiplier on every injected data defect. 0 gives perfectly clean sources.
SIM_DEFECT_RATE=1.0
# Share of API calls answered with HTTP 503.
SIM_API_ERROR_RATE=0.02

# Memory given to each Spark job.
SPARK_DRIVER_MEMORY=2g

# Warehouse (PostgreSQL). Change the host port if 5432 is already taken on
# your machine by another PostgreSQL.
WAREHOUSE_PASSWORD=warehouse
WAREHOUSE_HOST_PORT=5432
